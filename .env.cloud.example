COMPOSE_PROJECT_NAME=mcp-gateway-dev

# 默认仅允许通过云服务器本机或 SSH 隧道访问基础设施。
MYSQL_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1
NACOS_BIND_ADDRESS=127.0.0.1
MYSQL_EXPOSE_PORT=16033
REDIS_EXPOSE_PORT=19736
NACOS_HTTP_EXPOSE_PORT=18848
NACOS_GRPC_EXPOSE_PORT=19848
NACOS_GRPC_COMPAT_EXPOSE_PORT=19849

# 验收入口。开放公网前应通过云防火墙限制来源地址，正式环境应增加 HTTPS。
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=18080

MYSQL_DATABASE=mcp_gateway
MYSQL_USERNAME=mcp_gateway
MYSQL_PASSWORD=请替换为随机强密码
MYSQL_ROOT_PASSWORD=请替换为另一个随机强密码
REDIS_PASSWORD=请替换为随机强密码

NACOS_IMAGE=nacos/nacos-server:v2.5.3
