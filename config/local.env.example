# 复制为 config/local.env 后填写真实值。该文件不会提交到 Git。
# Nacos Server 地址与 Namespace ID；默认 public Namespace 留空，非默认 Namespace 填 ID 而不是显示名称。
# 若通过 SSH 隧道访问 Nacos 2.x，除该端口外还必须转发“端口 + 1000”的 gRPC 端口。
NACOS_SERVER_ADDR=你的-Nacos-地址:8848
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# MCP 网关 MySQL 连接；数据库结构由 mcp-gateway-server/src/main/resources/schema.sql 手工应用。
GATEWAY_DATABASE_URL=jdbc:mysql://127.0.0.1:3306/mcp_gateway?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
GATEWAY_DATABASE_USERNAME=mcp_gateway
GATEWAY_DATABASE_PASSWORD=请填写本机数据库密码

# MCP 验证台模型配置。API Key 仅保存在本机；Nacos 中同名配置存在时优先使用 Nacos。
OPENAI_API_KEY=请填写-OpenAI-API-Key
GATEWAY_VALIDATION_MODEL=deepseek-v4-flash
GATEWAY_VALIDATION_BASE_URL=https://api.deepseek.com

# 可选：覆盖本机端口。
MCP_GATEWAY_PORT=8080
MOCK_USER_SERVICE_PORT=8081
MOCK_ORDER_SERVICE_PORT=8082
MOCK_PRODUCT_SERVICE_PORT=8083
MOCK_INVENTORY_SERVICE_PORT=8084
MOCK_PAYMENT_SERVICE_PORT=8085
MOCK_LOGISTICS_SERVICE_PORT=8086

# 可选：覆盖各模拟业务服务用于触发网关超时的慢响应时长。
MOCK_ORDER_SLOW_RESPONSE_DELAY=PT16S
MOCK_PRODUCT_SLOW_RESPONSE_DELAY=PT16S
MOCK_INVENTORY_SLOW_RESPONSE_DELAY=PT16S
MOCK_PAYMENT_SLOW_RESPONSE_DELAY=PT16S
MOCK_LOGISTICS_SLOW_RESPONSE_DELAY=PT16S

# 首次下载 Maven/npm 依赖时可适当调大。
LOCAL_STARTUP_TIMEOUT_SECONDS=180
