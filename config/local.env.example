# 复制为 config/local.env 后填写真实值。该文件不会提交到 Git。
# Nacos Server 地址与 Namespace ID；不要填 Namespace 的显示名称。
# 若通过 SSH 隧道访问 Nacos 2.x，除该端口外还必须转发“端口 + 1000”的 gRPC 端口。
NACOS_SERVER_ADDR=你的-Nacos-地址:8848
NACOS_NAMESPACE=你的-Nacos-Namespace-ID
NACOS_GROUP=DEFAULT_GROUP

# 可选：覆盖本机端口。
MCP_GATEWAY_PORT=8080
MOCK_USER_SERVICE_PORT=8081

# 首次下载 Maven/npm 依赖时可适当调大。
LOCAL_STARTUP_TIMEOUT_SECONDS=180
