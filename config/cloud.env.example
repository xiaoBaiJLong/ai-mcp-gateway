# 复制为 config/cloud.env 后填写云端秘密；该文件不会提交到 Git。
# Nacos 连接范围与本机相同：默认 public Namespace 留空，非默认 Namespace 填 ID 而不是显示名称。
NACOS_NAMESPACE=
NACOS_GROUP=DEFAULT_GROUP

# MySQL 持久化数据与网关数据库账号。
MYSQL_DATABASE=mcp_gateway
GATEWAY_DATABASE_USERNAME=mcp_gateway
GATEWAY_DATABASE_PASSWORD=请填写-网关数据库密码
MYSQL_ROOT_PASSWORD=请填写-MySQL-root-密码

# 验证台模型配置。API Key 只存在云端部署环境；模型名与 Base URL 是启动默认值，
# Nacos 的 mcp-gateway-server.yaml 中 gateway.validation 配置存在时优先使用 Nacos。
OPENAI_API_KEY=请填写-OpenAI-API-Key
GATEWAY_VALIDATION_MODEL=gpt-4.1-mini
GATEWAY_VALIDATION_BASE_URL=https://api.openai.com/v1
